+++ b/vllm_ascend/distributed/kv_transfer/kv_pool/ascend_store/backend/backend.py
@@ -8,6 +8,8 @@ from vllm.config import ParallelConfig
 
 class Backend(ABC):
     store: Any | None = None
+    # Whether the connector must filter existing keys before calling put().
+    requires_exists_before_put: bool = True
 
     @abstractmethod
     def __init__(self, parallel_config: ParallelConfig):
