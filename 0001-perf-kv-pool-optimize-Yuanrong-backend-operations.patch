 .../ascend_store/backend/yuanrong_backend.py  | 205 ++++++------------
 .../kv_pool/ascend_store/kv_transfer.py       |  17 +-
 .../kv_pool/ascend_store/pool_worker.py       |   5 +-
 4 files changed, 89 insertions(+), 140 deletions(-)

diff --git a/vllm_ascend/distributed/kv_transfer/kv_pool/ascend_store/backend/backend.py b/vllm_ascend/distributed/kv_transfer/kv_pool/ascend_store/backend/backend.py
