+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.backend.yuanrong_backend import (
+    YuanrongBackend,
+    YuanrongConfig,
+)
